# ImgFlash 构建配置
# 修改此文件后重新构建即可生效

# --- 目标架构（amd64 / arm64） ---
ARCH=amd64

# --- Debian 仓库 ---
DEBIAN_MIRROR=https://ftp.debian.org/debian
DEBIAN_SUITE=

# --- ISO 元数据 ---
VOLUME_LABEL=IMGFLASH

# --- 内核模块 ---
#MOD_FILESYSTEM="squashfs isofs loop"
#MOD_NLS="nls_cp437 nls_ascii nls_utf8"
#MOD_ATA="ahci ata_piix ata_generic"
#MOD_USB="xhci-hcd ehci-hcd usb-storage uas"
#MOD_CDROM="sr_mod sd_mod cdrom"
#MOD_INPUT="hid usbhid"
#MOD_NVME="nvme"
#MOD_VIRT="virtio virtio_blk virtio_pci virtio_scsi"

MOD_FILESYSTEM="squashfs isofs loop overlay ext4 ext3 ext2 xfs btrfs f2fs vfat fat msdos exfat ntfs ntfs3"
MOD_NLS="nls_cp437 nls_ascii nls_utf8 nls_iso8859_1 nls_cp936 nls_cp950"
MOD_ATA="ahci ata_piix ata_generic ata_acpi ata_sff libata sata_sil sata_sil24 sata_sis sata_svw sata_via sata_nv sata_promise sata_qstor sata_sx4 sata_uli sata_mv pata_acpi pata_ali pata_amd pata_artop pata_atiixp pata_atp867x pata_cmd64x pata_cs5520 pata_cs5530 pata_cypress pata_efar pata_hpt366 pata_hpt37x pata_hpt3x2n pata_hpt3x3 pata_it8213 pata_it821x pata_jmicron pata_marvell pata_mpiix pata_netcell pata_ns87415 pata_oldpiix pata_opti pata_pdc2027x pata_pdc202xx_old pata_piccolo pata_rdc pata_sch pata_serverworks pata_sil680 pata_sis pata_triflex pata_via pata_winbond scsi_mod sd_mod sg scsi_transport_sas scsi_transport_spi scsi_transport_fc mpt2sas mpt3sas mpi3mr pm80xx aic94xx isci megaraid megaraid_mm megaraid_mbox megaraid_sas aacraid hpsa smartpqi hptiop 3w-sas 3w-9xxx 3w-xxxx arcmsr aic79xx aic7xxx ipr mvsas"
MOD_USB="xhci-hcd xhci-pci xhci-platform ehci-hcd ehci-pci ohci-hcd ohci-pci uhci-hcd uhci-pci usb-storage uas"
MOD_CDROM="sr_mod sd_mod sg cdrom scsi_mod scsi_transport_sas scsi_transport_spi scsi_transport_fc"
MOD_INPUT="hid usbhid hid-generic"
MOD_NVME="nvme nvme-core nvme-fabrics nvme-fc nvme-rdma nvme-tcp"
MOD_VIRT="virtio virtio_blk virtio_pci virtio_scsi virtio_ring"
MOD_EMMC="mmc_core mmc_block sdhci sdhci-pci sdhci-acpi sdhci-pci-o2micro cqhci"
MOD_EMMC_CARDREADER="rtsx_pci_sdmmc rtsx_usb_sdmmc tifm_sd tifm_7xx1 tifm_core toshsd via-sdmmc cb710-mmc"
MOD_EMMC_USB="vub300 ushc wbsd"



# --- 可选模块 ---
# 大量 pata_* / sata_*（老式 PATA/SATA 控制器）
# firewire-sbp2（火线存储）
# xen-blkfront xen-scsifront（Xen 虚拟化）
# pcmcia_core yenta_socket pata_pcmcia（PCMCIA 存储）
# vub300 ushc wbsd（USB 外接读卡器）

# --- 可选模块开关（设为 0 禁用，设为 1 启用） ---
INCLUDE_NVME=1
INCLUDE_VIRT=1

# --- 启动菜单超时（秒） ---
BOOT_TIMEOUT=0

# --- 内核启动参数 ---
KERNEL_PARAMS=quiet

# --- 启动扫描超时（秒） ---
SCAN_TIMEOUT=10

# --- 启用 Secure Boot ---
ENABLE_SECURE_BOOT=0

# --- 压缩级别 ---
ZSTD_LEVEL=19

# --- 安装器模式（1=TUI / 0=Shell脚本） ---
USE_TUI=1

# --- 自动扩容 ---
# GROW_ENABLED 是构建期能力开关（工具注入 ISO /grow/）
# grow.conf enabled= 是运行期策略开关
GROW_ENABLED=1
GROW_PART=auto

# --- 文件系统工具与内核模块 ---
# 打包哪些 fs 工具与内核模块没有配置项：
# 构建期探针按镜像自动推导
# LVM 目标用循环设备离线识别 PV 内层 fs
# 构建容器需 util-linux 与 lvm2
# fs -> 工具 / 模块映射见 grow-tools.sh
# 构建期与运行期共享同一分析层
