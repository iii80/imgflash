# ImgFlash 构建配置
# 修改此文件后重新构建即可生效

# --- 目标架构（amd64 / arm64） ---
ARCH=amd64

# --- Debian 仓库 ---
DEBIAN_MIRROR=https://ftp.debian.org/debian
DEBIAN_SUITE=

# --- ISO 元数据 ---
VOLUME_LABEL=IMGFLASH

# --- 内核模块 ---

# 文件系统
MOD_FILESYSTEM="squashfs isofs loop"

# NLS / 文件名字符集
MOD_NLS="nls_cp437 nls_ascii nls_utf8"

# SATA / ATA
MOD_ATA="ahci ata_piix ata_generic"

# SAS / SCSI / RAID / 服务器存储控制器
MOD_STORAGE="libsas scsi_transport_sas mpt2sas mpt3sas megaraid_sas megaraid megaraid_mbox megaraid_mm mvsas pm80xx hisi_sas hpsa aacraid smartpqi"

# SCSI 通用层
MOD_SCSI="scsi_mod sd_mod sg sr_mod cdrom"

# USB
MOD_USB="xhci-hcd xhci-pci ehci-hcd ehci-pci usb-storage uas"

# 输入设备
MOD_INPUT="hid usbhid"

# NVMe
MOD_NVME="nvme"

# VirtIO / KVM / QEMU
MOD_VIRT="virtio virtio_blk virtio_pci virtio_scsi"

# eMMC / SD
MOD_EMMC="mmc_core mmc_block sdhci sdhci-pci sdhci-acpi cqhci"

# eMMC / SD Card Reader
MOD_EMMC_CARDREADER="rtsx_pci_sdmmc rtsx_usb_sdmmc tifm_sd toshsd via-sdmmc cb710-mmc"

# --- 可选模块 ---
# 大量 pata_* / sata_*（老式 PATA/SATA 控制器）
# firewire-sbp2（火线存储）
# xen-blkfront xen-scsifront（Xen 虚拟化）
# pcmcia_core yenta_socket pata_pcmcia（PCMCIA 存储）
# vub300 ushc wbsd（USB 外接读卡器）

# --- 可选模块开关（设为 0 禁用，设为 1 启用） ---
INCLUDE_NVME=1
INCLUDE_VIRT=1

# --- 启动菜单超时（秒） ---
BOOT_TIMEOUT=0

# --- 内核启动参数 ---
KERNEL_PARAMS=quiet

# --- 启动扫描超时（秒） ---
SCAN_TIMEOUT=10

# --- 启用 Secure Boot ---
ENABLE_SECURE_BOOT=0

# --- 压缩级别 ---
ZSTD_LEVEL=19

# --- 安装器模式（1=TUI / 0=Shell脚本） ---
USE_TUI=1

# --- 自动扩容 ---
# GROW_ENABLED 是构建期能力开关（工具注入 ISO /grow/）
# grow.conf enabled= 是运行期策略开关
GROW_ENABLED=1
GROW_PART=auto

# --- 文件系统工具与内核模块 ---
# 打包哪些 fs 工具与内核模块没有配置项：
# 构建期探针按镜像自动推导
# LVM 目标用循环设备离线识别 PV 内层 fs
# 构建容器需 util-linux 与 lvm2
# fs -> 工具 / 模块映射见 grow-tools.sh
# 构建期与运行期共享同一分析层
